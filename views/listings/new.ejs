<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <form action="/listings" method="POST">
        <input name="Listing[title]" type="text" placeholder="enter title">
        <br><br>
        <textarea name="Listing[description]" type="text" placeholder="enter description"></textarea>
        <br><br>
        <input name="Listing[image]" type="text" placeholder="enter image">
        <br><br>
        <input name="Listing[price]" type="number" placeholder="enter price">
        <br><br>
        <input name="Listing[country]" type="text" placeholder="enter country">
        <br><br>
        <input name="Listing[location]" type="text" placeholder="enter location">
        <br><br>
        <button>
            Add
        </button>
    </form>
</body>
</html>