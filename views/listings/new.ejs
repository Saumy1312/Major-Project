<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-2">
    <br />
    <h3>Create New Listing</h3>

    <form class="listing-form needs-validation" action="/listings" method="POST" novalidate>
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="listing[title]" type="text" placeholder="enter title" class="form-control" required />
        <div class="valid-feedback">Title Looks Good</div>
        <div class="invalid-feedback">Enter Valid Title (1-100 characters)</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" placeholder="Describe your listing (min 10 characters)" required></textarea>
        <div class="invalid-feedback">Enter Valid Description (10-1000 characters)</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label">Image Link</label>
        <input name="listing[image][url]" type="url" class="form-control" placeholder="https://example.com/image.jpg" />
        <div class="invalid-feedback">Enter Valid Image URL</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input name="listing[price]" type="number" class="form-control" placeholder="0" min="0" step="0.01" required />
          <div class="invalid-feedback">Enter Valid Price (must be positive)</div>
        </div>
        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input name="listing[country]" type="text" class="form-control" placeholder="India" required />
          <div class="invalid-feedback">Enter Valid Country (1-50 characters)</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input name="listing[location]" type="text" class="form-control" placeholder="Varanasi, Uttar Pradesh" required />
        <div class="invalid-feedback">Enter Valid Location (1-100 characters)</div>
      </div>
      <br />
      <button class="btn btn-dark add-btn" type="submit">Add</button>
      <br /><br />
    </form>
  </div>
</div>
