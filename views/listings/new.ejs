<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <br>
         
<h3>Create New Listing</h3>

<body>
    <form action="/listings" method="POST">
        
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input name="Listing[title]" type="text" placeholder="enter title" class="form-control">
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="Listing[description]" type="text" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label for="image" class="form-label" >Image Link</label>
            <input name="Listing[image]" type="text" class="form-control" placeholder="add link">
        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="Listing[price]" type="number" class="form-control" placeholder="add price">
        </div>
            <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label> 
            <input name="Listing[country]" type="text" class="form-control" placeholder="select country">
        </div>
        </div>
        
        
        <div class="mb-3">
            <label for="location" class="form-label">Location</label> 
            <input name="Listing[location]" type="text" class="form-control" placeholder="Varanasi India">
        </div>
       <br> 
        <button class="btn btn-dark add-btn">
            Add
        </button>
        <br><br>
    </form>
</body>
</div>
</div>