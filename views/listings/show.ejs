<% layout("/layouts/boilerplate"); %>
<div class="row mt-3">
   <div class="col-8 offset-3">  

     <h2><%=listing.title%></h2>
     </div>
     <div  class="col-6 offset-3 show-card listing-card"> 
         <img src="<%= listing.image.url %>" class="card-img-top  show-img" alt="...">
         <div class="card-body">
            <h5 class="card-title"></h5>
            <p class="card-text">
               <%=listing.description%> <br>
               &#8377;<%=listing.price.toLocaleString("en-IN")%> <br>
               <%=listing.location%> <br>
               <%=listing.country%> <br>
            </p>
         </div>
     </div>
     <div class="btns">
         <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-3 edit-btn mt-4">Edit</a>
         <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
               <button class="btn btn-dark offset-5 mt-4">
                  Delete
               </button>
     </form>
     </div>
     
       <div class="col-8 offset-3 mb-3">
         <hr>
          <h3>Leave a Review</h3>
          <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation" >
            <div  class="mb-3 mt-3">
               <label for="rating" class="form-label">Rating</label>
               <input type="range" id="rating" name="review[rating]" min="1" max="5" class="form-range">
            </div>
            <div class="mb-3 mt-3">
               <label for="comment" class="form-label">Comments</label>
               <textarea 
               name="review[comment]" 
               id="comment" 
               rows="5" 
               cols="30" 
               class="form-control"
               required
               ></textarea>
               <div class="invalid-feedback">Please add some comments</div>

            </div>
            <div>
               <button class="btn btn-dark mt-4">Submit</button>
          </form>
          <hr>
          <p><b>All Reviews</b></p>
          <div class="row">
          <%for(review of listing.reviews) { %>
           <div class="card col-5 ms-3 mb-3 ">
            <div class="card-body">
               <h5 class="card-title">Saumy</h5>
               <p class="card-text"><%=review.comment%></p>
               <p class="card-text"><%=review.rating%> Stars </p>
            </div>
           </div>
           

          <% } %>
          </div>
</div>

