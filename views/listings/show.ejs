<% layout("/layouts/boilerplate"); %>
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing)%>;
</script>
<div class="row mt-3">
   <div class="col-8 offset-3">  
     <h2><%=listing.title%></h2>
     </div>
     <div  class="col-6 offset-3 show-card listing-card"> 
         <img src="<%= listing.image.url %>" class="card-img-top  show-img" alt="...">
         <div class="card-body">
            <h5 class="card-title"></h5>
            <p class="card-text">
               <p>Owned by: <i><%= listing.owner.username %></i></p>
               <p><%=listing.description%></p>
               <p>&#8377;<%=listing.price.toLocaleString("en-IN")%></p>
               <p><%=listing.location%></p>
               <p><%=listing.country%></p>
            </p>
         </div>
     </div>
     <% if(currentUser && currentUser._id.equals(listing.owner._id)) { %>
     <div class="btns">
         <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark col-1 offset-3 edit-btn mt-4 ">Edit</a>
         <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
               <button class="btn btn-dark offset-5 mt-4">
                  Delete
               </button>
     </form>
     </div>
       <% } %>

       <!-- Review Form Section -->
       <div class="col-6 offset-3 mb-3">
    <hr>
    
    <% if(currentUser) { %>
        <div class="review-form">
            <h4>Leave a Review</h4>
            
            <form action="/listings/<%=listing._id%>/reviews" method="POST" class="needs-validation">
                <div class="mb-3">
                    <label class="form-label">Rating</label>
                    <div class="rating-input">
                        <input type="radio" name="review[rating]" value="5" id="star5">
                        <label for="star5">★</label>
                        <input type="radio" name="review[rating]" value="4" id="star4">
                        <label for="star4">★</label>
                        <input type="radio" name="review[rating]" value="3" id="star3">
                        <label for="star3">★</label>
                        <input type="radio" name="review[rating]" value="2" id="star2">
                        <label for="star2">★</label>
                        <input type="radio" name="review[rating]" value="1" id="star1">
                        <label for="star1">★</label>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Comments</label>
                    <textarea name="review[comment]" rows="3" class="form-control" placeholder="Share your experience..." required></textarea>
                </div>
                
                <button type="submit" class="btn btn-primary">Submit Review</button>
            </form>
        </div>
    <% } %>
    
    <!-- All Reviews Section -->
    <div class="reviews-list mt-4">
        <div class="reviews-header">
            <h4 class="mt-1">All Reviews</h4>
            <% if(listing.reviews && listing.reviews.length > 0) { %>
                <div class="reviews-summary">
                    <span class="review-count"><%= listing.reviews.length %> reviews</span>
                    <% 
                        let totalRating = listing.reviews.reduce((sum, review) => sum + review.rating, 0);
                        let avgRating = (totalRating / listing.reviews.length).toFixed(1);
                    %>
                    <div class="avg-rating">
                        <span class="avg-number"><%= avgRating %></span>
                        <div class="avg-stars">
                            <% for(let i = 1; i <= 5; i++) { %>
                                <span class="<%= i <= Math.round(avgRating) ? 'star-filled' : 'star-empty' %>">★</span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
        
        <% if(listing.reviews && listing.reviews.length > 0) { %>
            <div class="reviews-grid">
                <% listing.reviews.forEach(function(review) { %>
                    <div class="review-item">
                        <div class="review-header">
                            <span class="username">@<%= review.author.username %></span>
                            <div class="stars">
                                <% for(let i = 1; i <= 5; i++) { %>
                                    <span class="<%= i <= review.rating ? 'star-filled' : 'star-empty' %>">★</span>
                                <% } %>
                            </div>
                            <% if(currentUser && currentUser._id.equals(review.author._id)) { %>
                                <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST" style="display:inline;">
                                    <button class="btn-delete">Delete</button>
                                </form>
                            <% } %>
                        </div>
                        <p class="review-text"><%= review.comment %></p>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="no-reviews">
                <div class="no-reviews-icon">📝</div>
                <h5>No reviews yet</h5>
                <p>Be the first to share your experience with this listing!</p>
                <% if(!currentUser) { %>
                    <p><a href="/login">Login</a> to leave a review</p>
                <% } %>
            </div>
        <% } %>
    </div>
    
</div>
<div class="col-8 offset-3 mb-3">
        <h3>Where you'll be</h3>
        <div id="map"></div>
    </div>

</div>

<script src="/js/map.js">

</script>
